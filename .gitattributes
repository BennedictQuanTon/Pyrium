# Normalize every text file to LF in the repo and on checkout (Windows teammates included).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.webm  binary

# Generated lockfile: collapse in GitHub diffs.
pnpm-lock.yaml  linguist-generated=true
